{
  "schema_version": "ember_pi05_video_expert_manifold_v1",
  "authorities": {
    "target_data_manifest": {
      "path": "configs/pi05_target_data_v1/manifest.json"
    },
    "evaluation_config": {
      "path": "configs/pi05_target_evaluation_v1.json"
    },
    "lora_contract": {
      "path": "configs/pi05_lora_v1.json"
    },
    "source_base_config": {
      "path": "configs/pi05_source_base_v1.json"
    }
  },
  "method": {
    "name": "video_conditioned_expert_manifold_topological_writer",
    "writer_input": "exact task language plus exactly one action-hidden teacher video",
    "dynamic_value": "frozen_pi05_joint_video_innovation_minus_matched_text_no_image_baseline",
    "language_only_lora_path": false,
    "deployment_output": "one complete rank16 public LoRA",
    "future_credit": [
      "expert_weight_reconstruction",
      "functional_action",
      "official_binary_reward"
    ]
  },
  "information_wall": {
    "expert_action_split_roles": [
      "train"
    ],
    "writer_video_split_roles": [
      "train"
    ],
    "writer_forbidden_inputs": [
      "action",
      "proprio",
      "state",
      "reward",
      "terminal",
      "task_id",
      "filename",
      "object_pose",
      "hidden_normalization",
      "policy_outcome"
    ],
    "validation_experts_trained": 0,
    "test_experts_trained": 0,
    "validation_actions_read": 0,
    "test_actions_read": 0
  },
  "task_experts": {
    "task_count": 24,
    "episodes_per_task": 50,
    "demo_indices": [
      0,
      49
    ],
    "action_chunk_size": 50,
    "lora_topology": "configs/pi05_lora_v1.json:38targets:rank16",
    "initialization": "shared deterministic template-A and exact zero-B for every task",
    "task_parameter_sharing": "none",
    "checkpoint_selection": "one global step for all 24 experts from development-train closed loop",
    "sampler": {
      "kind": "deterministic_task_local_epoch_permutation",
      "seed": 20260807,
      "worker_random_transforms": false
    },
    "optimization": {
      "precision": "bfloat16",
      "gradient_checkpointing": true,
      "optimizer": {
        "name": "AdamW",
        "betas": [
          0.9,
          0.999
        ],
        "eps": 1e-08,
        "weight_decay": 0.0001,
        "gradient_clip_norm": 1.0
      },
      "scheduler": {
        "kind": "cosine_decay_with_warmup",
        "peak_lr": 5e-05,
        "warmup_steps": 25,
        "decay_lr": 1e-07
      },
      "seed": 7
    },
    "profile_defaults": {
      "total_steps": 3,
      "scheduler_total_steps": 2000,
      "per_task_batch_size": 16,
      "checkpoint_steps": [
        1,
        3
      ]
    },
    "formal_run": {
      "status": "blocked_until_live_a40_profile",
      "total_steps": 2000,
      "per_task_batch_size": 16,
      "checkpoint_steps": [
        250,
        500,
        1000,
        1500,
        2000
      ],
      "allowed_worker_count": 6,
      "tasks_per_worker": 4,
      "selected_stop_step": 1000,
      "stage_stop_steps": [
        1000,
        2000
      ]
    }
  },
  "video_features": {
    "shots": 1,
    "frame_stride": 5,
    "phase_slots": 16,
    "feature_width": 2048,
    "source_policy_trainable": false,
    "cache_contains_actions_or_state": false
  },
  "topological_writer": {
    "chunk_width": 512,
    "chunk_count": 168,
    "public_rank": 16,
    "valid_values": 1287168,
    "padded_values": 1376256,
    "memory_width": 512,
    "attention_heads": 8,
    "axial_blocks": 4,
    "output": "zero_initialized_direct_chunk_values_plus_per_chunk_scale",
    "identity": "template-A plus zero-B"
  },
  "content_hash_policy": "disabled_by_owner"
}
